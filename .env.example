# Copiar a .env y completar. .env NO se versiona.
#
# Ninguno de estos valores es un secreto: son direcciones e identificadores. La
# credencial que autentica esta aplicacion la resuelve DefaultAzureCredential —
# Managed Identity en Azure, o la sesion de `az login` en local — y nunca se
# escribe en ningun archivo.

# Direccion publica de la API de Centinela (sin barra final). El nombre real de
# la Container App es 'ca-<NAME_PREFIX>-api' (con NAME_PREFIX=cent: ca-cent-api).
# Obtener el FQDN con:
#   az containerapp show -g <grupo> -n ca-<NAME_PREFIX>-api \
#     --query properties.configuration.ingress.fqdn -o tsv
CENTINELA_BASE_URL=https://ca-<prefijo>-api.<entorno>.<region>.azurecontainerapps.io

# Ambito del token: api://<appId>/.default, donde <appId> es el appId del
# registro '<NAME_PREFIX>-api-week1' en Entra ID.
CENTINELA_SCOPE=api://<application-id>/.default

# --- Solo para scripts/deploy-lab.sh (despliegue en Azure) -------------------
# Estos cuatro parametros NO los usa la aplicacion: los usa el script de
# despliegue, y deben ser LOS MISMOS con los que se desplego Centinela.
# SUBSCRIPTION_ID=<uuid-de-la-suscripcion>
# RESOURCE_GROUP=rg-centinela
# LOCATION=eastus2
# NAME_PREFIX=cent

# Puerto local (opcional).
SERVER_PORT=8081

# Margenes de espera (opcionales). Subir el de explicacion si el explicador
# arranca desde cero replicas.
CENTINELA_WAIT_ANALYSIS=45
CENTINELA_WAIT_EXPLANATION=60
CENTINELA_POLL_INTERVAL=3
